# Short Report Rebuttal Assistant - Environment Configuration

# Provider: "openai" or "ollama"
LLM_PROVIDER=openai

# ============================================
# OpenAI Configuration (required if LLM_PROVIDER=openai)
# ============================================
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-large

# ============================================
# Ollama Configuration (required if LLM_PROVIDER=ollama)
# ============================================
# Uncomment these lines if using Ollama:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1:8b
# EMBED_MODEL=nomic-embed-text

# ============================================
# Storage Paths (optional, defaults work for most cases)
# ============================================
# CHROMA_DIR=storage/chroma
# INTERNAL_DATA_DIR=company/EDU
# REPORTS_DIR=storage/reports

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
